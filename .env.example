# Server-only website -> CRM integration. Never prefix the secret with NEXT_PUBLIC_.
DOMINASE_CRM_BASE_URL=
DOMINASE_CRM_INGEST_SECRET=
DOMINASE_WEBSITE_ALLOWED_ORIGINS=

# Optional server-side email notification after the CRM has accepted the lead.
FORMSPREE_ENDPOINT=
# Diagnosis defaults safely to V1 when these server-side flags are absent.
DIAGNOSIS_ENGINE_CLINIC=v1
DIAGNOSIS_ENGINE_ENGINEERING=v1
DIAGNOSIS_ENGINE_GENERAL_BUSINESS=v1
DIAGNOSIS_ENGINE_VENUE=v1
DIAGNOSIS_QA_ENABLED=false
